# Android / Gradle
.gradle/
.gradle
build/
**/build/
!**/src/**/build/
local.properties
*.iml
.idea/
captures/
.externalNativeBuild/
.gradletasknamecache

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignoring Gradle wrapper properties
!gradle-wrapper.properties

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store

# Local-only Gradle config (e.g. org.gradle.java.home pointing at a
# machine-specific JDK). Never commit this; every machine differs.
gradle.properties

# Firebase Android config (needed only when the app is registered in the
# Firebase console, e.g. for App Check). Machine-specific: never commit.
app/google-services.json

# Test render outputs
output/
