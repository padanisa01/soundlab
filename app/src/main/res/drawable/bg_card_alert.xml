<?xml version="1.0" encoding="utf-8"?>
<!-- Transport card while a soundcheck clip flash is active (V5 cue):
     same fill and corners as bg_card, with a red border. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/sl_card"/>
    <stroke android:width="2dp" android:color="@color/sl_red"/>
    <corners android:radius="18dp"/>
</shape>
