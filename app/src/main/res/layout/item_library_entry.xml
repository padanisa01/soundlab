<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:padding="12dp">

    <!-- Row 1: export dot + name + overflow. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/row_export_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginRight="8dp"
            android:background="@drawable/dot_teal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/row_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sl_txt"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <ImageButton
            android:id="@+id/row_overflow"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_overflow"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Recording options" />
    </LinearLayout>

    <!-- Row 2: date/time · duration · size. -->
    <TextView
        android:id="@+id/row_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/sl_mut"
        android:textSize="12sp" />

    <!-- Row 2b: the project's track names, in track order. -->
    <TextView
        android:id="@+id/row_tracks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/sl_txt"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <!-- Row 3: effect chips (added programmatically, up to 3 + "+N"). -->
    <LinearLayout
        android:id="@+id/row_chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp" />
</LinearLayout>
