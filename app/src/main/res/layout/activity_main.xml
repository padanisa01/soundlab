<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sl_phone">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- App bar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sound"
                    android:textColor="@color/sl_txt"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lab"
                    android:textColor="@color/sl_teal2"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Pick button: visible until a file is picked -->
            <Button
                android:id="@+id/btn_pick"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_apply"
                android:text="Pick audio (WAV)"
                android:textColor="@color/sl_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:padding="14dp" />

            <!-- Track card -->
            <LinearLayout
                android:id="@+id/track_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_icon_tile"
                    android:padding="10dp"
                    android:src="@drawable/ic_note" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_track_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sl_txt"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_track_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:textColor="@color/sl_mut"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_normalize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_ghost"
                    android:text="Normalize"
                    android:textColor="@color/sl_teal2"
                    android:textSize="12.5sp"
                    android:padding="8dp" />

                <Button
                    android:id="@+id/btn_change"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ghost"
                    android:text="Change"
                    android:textColor="@color/sl_txt"
                    android:textSize="12.5sp"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- Waveform card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="WAVEFORM"
                        android:textColor="@color/sl_mut"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <Button
                        android:id="@+id/btn_zoom_in"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_zoom_btn"
                        android:text="+"
                        android:textColor="@color/sl_txt"
                        android:textSize="16sp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/btn_zoom_out"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_zoom_btn"
                        android:text="−"
                        android:textColor="@color/sl_txt"
                        android:textSize="16sp"
                        android:padding="0dp" />
                </LinearLayout>

                <com.audiofx.app.WaveformView
                    android:id="@+id/waveform"
                    android:layout_width="match_parent"
                    android:layout_height="170dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_wave" />

                <LinearLayout
                    android:id="@+id/sel_chip_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_sel_chip_empty"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <TextView
                        android:id="@+id/sel_chip_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Full track"
                        android:textColor="@color/sl_mut"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btn_sel_clear"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:text="×"
                        android:textColor="@color/sl_teal2"
                        android:textSize="18sp"
                        android:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_record"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:background="@drawable/bg_record_btn"
                        android:contentDescription="Record"
                        android:scaleType="fitCenter" />

                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="62dp"
                        android:layout_height="62dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_play_btn"
                        android:contentDescription="Play or pause"
                        android:elevation="8dp"
                        android:enabled="false"
                        android:padding="16dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_play" />

                    <ImageButton
                        android:id="@+id/btn_stop"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_chip"
                        android:contentDescription="Stop"
                        android:enabled="false"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_stop" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_time_cur"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/sl_txt"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / "
                            android:textColor="@color/sl_mut"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_time_tot"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0:00"
                            android:textColor="@color/sl_mut"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_source"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_source_pill"
                        android:paddingStart="11dp"
                        android:paddingEnd="11dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:text="INPUT"
                        android:textColor="@color/sl_org"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Tap waveform: start marker · tap again: end marker · double-tap: clear · scroll or +/−: zoom · drag: pan when zoomed"
                    android:textColor="@color/sl_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Microphone card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_icon_tile"
                        android:padding="9dp"
                        android:src="@drawable/ic_mic" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Microphone"
                            android:textColor="@color/sl_txt"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Capture preprocessing"
                            android:textColor="@color/sl_dim"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Automatic gain control"
                            android:textColor="@color/sl_txt"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Evens out loud and quiet parts"
                            android:textColor="@color/sl_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_agc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/sl_teal"
                        android:trackTint="@color/sl_card2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/sl_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Noise suppression"
                            android:textColor="@color/sl_txt"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cuts background hiss and hum"
                            android:textColor="@color/sl_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_ns"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/sl_teal"
                        android:trackTint="@color/sl_card2" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/sl_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Live effects"
                            android:textColor="@color/sl_txt"
                            android:textSize="13.5sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hear Warmth, Reverb, Echo while recording; baked into the take"
                            android:textColor="@color/sl_dim"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/switch_livefx"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/sl_teal"
                        android:trackTint="@color/sl_card2" />
                </LinearLayout>
            </LinearLayout>

            <!-- Effects header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Effects"
                    android:textColor="@color/sl_txt"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="applied in order: Warmth → Reverb → Echo"
                    android:textColor="@color/sl_dim"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- Warmth card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile"
                    android:padding="9dp"
                    android:src="@drawable/ic_flame" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Warmth"
                            android:textColor="@color/sl_txt"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_warmth_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50%"
                            android:textColor="@color/sl_teal2"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_warmth"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="50"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_thumb" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Saturated low-end · 0% is an exact bypass"
                        android:textColor="@color/sl_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Reverb card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile"
                    android:padding="9dp"
                    android:src="@drawable/ic_reverb" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Reverb"
                            android:textColor="@color/sl_txt"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_reverb_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Concert Hall"
                            android:textColor="@color/sl_teal2"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:useDefaultMargins="false">

                        <LinearLayout
                            android:id="@+id/chip_studio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginEnd="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/chip_studio_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Studio"
                                android:textColor="@color/sl_txt"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="tight &amp; dry"
                                android:textColor="@color/sl_mut"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_hall"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginStart="4dp"
                            android:layout_marginBottom="8dp"
                            android:background="@drawable/bg_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/chip_hall_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Concert Hall"
                                android:textColor="@color/sl_teal2"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="lush &amp; wide"
                                android:textColor="@color/sl_mut"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_bath"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/chip_bath_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Bathroom"
                                android:textColor="@color/sl_txt"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="bright slap"
                                android:textColor="@color/sl_mut"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/chip_cave"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_columnWeight="1"
                            android:layout_gravity="fill_horizontal"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/bg_chip"
                            android:clickable="true"
                            android:focusable="true"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:paddingStart="12dp">

                            <TextView
                                android:id="@+id/chip_cave_name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Cave"
                                android:textColor="@color/sl_txt"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="vast &amp; dark"
                                android:textColor="@color/sl_mut"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </GridLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Synthesized decaying-noise impulse response per preset"
                        android:textColor="@color/sl_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Echo card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_tile"
                    android:padding="9dp"
                    android:src="@drawable/ic_echo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Echo"
                            android:textColor="@color/sl_txt"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_echo_val"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30%"
                            android:textColor="@color/sl_teal2"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <SeekBar
                        android:id="@+id/seek_echo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="30"
                        android:progressDrawable="@drawable/seekbar_progress"
                        android:splitTrack="false"
                        android:thumb="@drawable/seekbar_thumb" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="320 ms feedback delay · 0% is an exact bypass"
                        android:textColor="@color/sl_dim"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Apply -->
            <Button
                android:id="@+id/btn_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_apply"
                android:text="Apply Effects"
                android:textColor="@color/sl_white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:padding="16dp" />

            <!-- Undo / Save row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp">

                    <Button
                        android:id="@+id/btn_undo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ghost"
                        android:enabled="false"
                        android:text="↩ Undo"
                        android:textColor="@color/sl_txt"
                        android:textSize="14sp"
                        android:padding="13dp" />

                    <TextView
                        android:id="@+id/undo_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="6dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_badge_zero"
                        android:gravity="center"
                        android:minWidth="20dp"
                        android:minHeight="20dp"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:text="0"
                        android:textColor="@color/sl_mut"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <Button
                    android:id="@+id/btn_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:background="@drawable/bg_ghost"
                    android:enabled="false"
                    android:text="Save as MP3"
                    android:textColor="@color/sl_txt"
                    android:textSize="14sp"
                    android:padding="13dp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Toast pill -->
    <TextView
        android:id="@+id/toast_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="26dp"
        android:background="@drawable/bg_toast"
        android:elevation="8dp"
        android:gravity="center"
        android:padding="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/sl_txt"
        android:textSize="13sp"
        android:visibility="gone" />

</FrameLayout>
